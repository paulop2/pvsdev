{
  "$schema": "../../harness/delivery-queue/schema/policy-v1.json",
  "version": 1,
  "repository": "paulop2/pvsdev",
  "mergeMode": "auto",
  "defaultBranch": "master",
  "project": null,
  "fallbackEligibility": "label:delivery-queue-ready",
  "worktreeSetupCommands": [
    "npm ci --no-audit --no-fund",
    "cd ai && npm ci --no-audit --no-fund"
  ],
  "requiredChecks": [
    "npm run typecheck",
    "npm run build",
    "npm test",
    "cd ai && npm run typecheck",
    "cd ai && npm test"
  ],
  "requiredRemoteChecks": [],
  "postMergeSetupCommands": [
    "npm ci --no-audit --no-fund",
    "cd ai && npm ci --no-audit --no-fund"
  ],
  "postMergeRetries": 2,
  "merge": {
    "method": "merge",
    "requireChecksOnPr": true,
    "verifyDefaultBranchAfterMerge": true,
    "authorizedByLocalRules": true,
    "allowAdminBypass": false
  },
  "completionWithoutCode": "requires-evidence",
  "workerTimeoutMinutes": 60,
  "worktreeRoot": ".worktrees"
}
